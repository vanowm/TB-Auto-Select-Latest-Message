{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"additionalProperties": false,
	"description": "Manifest V2 fields used by this add-on, including Thunderbird experiment APIs. See https://webextension-api.thunderbird.net/en/mv2/guides/experiments.html",
	"properties": {
		"author": {
			"type": "string"
		},
		"background": {
			"additionalProperties": false,
			"properties": {
				"scripts": {
					"items": {
						"minLength": 1,
						"type": "string"
					},
					"minItems": 1,
					"type": "array"
				}
			},
			"required": ["scripts"],
			"type": "object"
		},
		"browser_specific_settings": {
			"additionalProperties": false,
			"properties": {
				"gecko": {
					"additionalProperties": false,
					"properties": {
						"id": {
							"minLength": 1,
							"type": "string"
						},
						"strict_max_version": {
							"type": "string"
						},
						"strict_min_version": {
							"type": "string"
						}
					},
					"type": "object"
				}
			},
			"type": "object"
		},
		"description": {
			"maxLength": 132,
			"type": "string"
		},
		"experiment_apis": {
			"additionalProperties": {
				"additionalProperties": false,
				"properties": {
					"parent": {
						"additionalProperties": false,
						"properties": {
							"events": {
								"items": {
									"enum": ["startup"]
								},
								"type": "array"
							},
							"paths": {
								"items": {
									"items": {
										"type": "string"
									},
									"minItems": 1,
									"type": "array"
								},
								"minItems": 1,
								"type": "array"
							},
							"scopes": {
								"items": {
									"enum": [
										"addon_parent",
										"content_parent",
										"devtools_parent"
									]
								},
								"type": "array"
							},
							"script": {
								"minLength": 1,
								"type": "string"
							}
						},
						"required": ["script"],
						"type": "object"
					},
					"schema": {
						"minLength": 1,
						"type": "string"
					}
				},
				"required": [
					"schema",
					"parent"
				],
				"type": "object"
			},
			"minProperties": 1,
			"type": "object"
		},
		"manifest_version": {
			"const": 2
		},
		"name": {
			"maxLength": 75,
			"minLength": 1,
			"type": "string"
		},
		"options_ui": {
			"additionalProperties": false,
			"properties": {
				"open_in_tab": {
					"type": "boolean"
				},
				"page": {
					"minLength": 1,
					"type": "string"
				}
			},
			"required": ["page"],
			"type": "object"
		},
		"permissions": {
			"items": {
				"type": "string"
			},
			"type": "array",
			"uniqueItems": true
		},
		"version": {
			"pattern": "^\\d{2}\\.[1-9]\\d?\\.[1-9]\\d?\\.(0|[1-9]\\d{0,3})$",
			"type": "string"
		}
	},
	"required": [
		"manifest_version",
		"name",
		"version"
	],
	"title": "Auto Select Latest Message Thunderbird manifest",
	"type": "object"
}
