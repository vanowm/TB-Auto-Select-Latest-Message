		"eslint-plugin-json-schema-validator": "5.4.0",
		"eslint-plugin-jsonc": "2.20.1",
		"eslint-plugin-prefer-arrow-functions": "3.4.2",
		"eslint-plugin-promise": "6.6.0",
		"eslint-plugin-sonarjs": "0.25.1",
