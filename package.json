	"license": "GPL-3",
	"name": "auto-select-latest-message",
	"scripts": {
		"atn:check": "node scripts/check-atn.cjs",
		"build": "web-ext build --filename auto-select-latest-message-{version}.xpi",
		"format": "node scripts/format.cjs",
		"format:check": "node scripts/format.cjs --check",
		"lint": "node scripts/format.cjs --lint",
		"prebuild": "npm run privacy:check",
		"privacy:check": "node scripts/privacy.cjs",
		"release:check": "node scripts/release.cjs metadata",
		"test": "node --test tests/addon.test.cjs tests/privacy.test.cjs tests/atn.test.cjs",
		"test:thunderbird": "node tests/thunderbird-smoke.cjs"
	},
	"version": "26.11.12.2044",
	"webExt": {
		"artifactsDir": "dist/",
		"build": {
			"asNeeded": false,
			"overwriteDest": true
		},
		"sourceDir": "src/"
	}
