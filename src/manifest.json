{
	"author": "V@no",
	"background": {
		"scripts": [
			"settings.js",
			"selection.js",
			"background.js"
		]
	},
	"browser_specific_settings": {
		"gecko": {
			"id": "autoselectlatestmessage@vano",
			"strict_max_version": "161.*",
			"strict_min_version": "128.0"
		}
	},
	"description": "Automatically select and display latest message on startup or when switching folder for the first time",
	"manifest_version": 2,
	"name": "Auto Select Latest Message",
	"options_ui": {
		"open_in_tab": true,
		"page": "options.html"
	},
	"permissions": [
		"accountsRead",
		"messagesRead",
		"storage"
	],
	"version": "26.11.12.1007"
}
